# Environment variables for LLM Deception Detection
# Copy this to .env and fill in your values: cp env.template .env

# Code/repo location (where you run from)
PROJECT_ROOT=/path/to/project/llm-deception-detection

# Data/logs/outputs location (larger quota project space)
CLUSTER_WORK_DIR=/path/to/project/llm-deception-detection

WANDB_API=your_key_here
WANDB_PROJECT=llm-deception-detection
# WANDB_ENTITY=your_entity
# W&B mode (optional, set to 'offline' to disable syncing)
# WANDB_MODE=offline

HF_TOKEN=your_hf_token_here

OPENAI_API_KEY=your_openai_key_here
